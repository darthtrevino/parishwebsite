<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ page.url | absoluteUrl }}" />
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }} News" href="/news/feed.xml" />
    <link rel="stylesheet" href="/assets/css/style.css" />

    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Church",
        "name": {{ site.title | dump | safe }},
        "url": {{ site.url | dump | safe }},
        "telephone": {{ site.phone | dump | safe }},
        "email": {{ site.email | dump | safe }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ site.address.street | dump | safe }},
          "addressLocality": {{ site.address.city | dump | safe }},
          "addressRegion": {{ site.address.region | dump | safe }},
          "postalCode": {{ site.address.postalCode | dump | safe }},
          "addressCountry": {{ site.address.country | dump | safe }}
        }
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/header.njk" %}
    <main id="main">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
  </body>
</html>
